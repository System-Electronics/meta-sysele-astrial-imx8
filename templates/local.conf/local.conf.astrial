
##########################################################
BB_NUMBER_THREADS = "8"
PARALLEL_MAKE = "-j 4"
##########################################################

INHERIT += "rm_work"

##########################################################
# SBOM and CVE check. Levels: none, standard, full (adds checksums).
##########################################################
SYSELE_SBOM ??= "none"

INHERIT += "${@bb.utils.contains_any('SYSELE_SBOM', 'standard full', 'create-spdx cve-check', '', d)}"
SPDX_PRETTY = "1"
SPDX_ARCHIVE_PACKAGED = "${@bb.utils.contains('SYSELE_SBOM', 'full', '1', '0', d)}"

CVE_CHECK_REPORT_PATCHED = "1"

CVE_CHECK_SHOW_WARNINGS = "0"

# Skip CVE checks for build-time-only tools.
CVE_CHECK_SKIP_RECIPE:append:class-native = " ${PN}"
CVE_CHECK_SKIP_RECIPE:append:class-nativesdk = " ${PN}"
CVE_CHECK_SKIP_RECIPE:append:class-cross = " ${PN}"
CVE_CHECK_SKIP_RECIPE:append:class-crosssdk = " ${PN}"
CVE_CHECK_SKIP_RECIPE:append:class-cross-canadian = " ${PN}"

# NVD database cache, shared across dev builds and releases.
CVE_CHECK_DB_DLDIR_FILE = "${TOPDIR}/../../yocto-cache/CVE_CHECK/${CVE_CHECK_DB_FILENAME}"

NVDCVE_API_KEY ??= "${NVD_API_KEY}"

CVE_DB_UPDATE_ATTEMPTS = "20"
##########################################################

##########################################################
# Build Info
##########################################################
INHERIT += "image-buildinfo"
IMAGE_BUILDINFO_VARS:append = " DATETIME DISTRO_NAME IMAGE_BASENAME MACHINE TUNE_PKGARCH" 
IMAGE_BUILDINFO_VARS:append = " MACHINE_FEATURES DISTRO_FEATURES COMMON_FEATURES IMAGE_FEATURES"
IMAGE_BUILDINFO_VARS:append = " TUNE_FEATURES TARGET_FPU"
##########################################################
#
# Workaround: crates.io fetch fails with wget's default UA;
FETCHCMD_wget = "/usr/bin/env wget -t 2 -T 30 --passive-ftp --user-agent='bitbake/2.0'"
#
